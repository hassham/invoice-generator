# Copy this file to .env (gitignored - never commit real values) and fill in real credentials.
# Loaded automatically at startup by Program.cs via DotNetEnv, only when a .env file is present.
# "__" nests into configuration sections, e.g. Email__Host -> configuration key "Email:Host".

# SMTP delivery for password-reset emails (SmtpPasswordResetEmailSender). Leave unset/blank to
# keep using the dev-only LoggingPasswordResetEmailSender stub, which logs the reset link instead
# of sending it - no real credentials are required for local dev, CI, or tests.
Email__Host=
Email__Port=587
Email__Username=
Email__Password=
Email__FromAddress=
Email__FromName=Invoice App
Email__UseStartTls=true
